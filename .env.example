# Copy to .env for LOCAL use only. .env is gitignored and must stay that way.
#
# GitHub Actions does NOT read this file. CI secrets live in:
#   GitHub repo -> Settings -> Secrets and variables -> Actions
#
# For local deploys, prefer `pnpm wrangler login` (scoped OAuth) over putting a
# long-lived API token here.

# Cloudflare account ID — dashboard sidebar, or the subdomain of your R2 endpoint
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with "Edit Cloudflare Workers" permission
CLOUDFLARE_API_TOKEN=
