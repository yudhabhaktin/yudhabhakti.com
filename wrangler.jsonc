{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yudhabhakti-com",
  "compatibility_date": "2026-08-01",

  // The site is served from the custom domain only. workers.dev stays off so
  // there is a single origin, matching the canonical URLs the pages emit.
  "workers_dev": false,
  "routes": [
    { "pattern": "yudhabhakti.com", "custom_domain": true },
    { "pattern": "www.yudhabhakti.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
