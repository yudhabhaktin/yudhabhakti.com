---
import { SITE, NAV, SOCIAL } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image (1200x630). */
  image?: string;
  /** Emit BlogPosting structured data instead of the default Person/WebSite. */
  article?: { published: Date; updated?: Date; tags?: string[] };
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  article,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href.replace(
  /(?<=.)\/$/,
  ''
);
const ogImage = image ? new URL(image, Astro.site ?? SITE.url).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  email: SITE.email,
  jobTitle: 'Technical Lead',
  description: SITE.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Gadjah Mada' },
  knowsAbout: [
    'Solution Architecture',
    'Cloud Computing',
    'Embedded Systems',
    'Edge Computing',
    'Applied AI',
    'Retrieval-Augmented Generation',
  ],
  sameAs: ['https://github.com/bhaktiyudha', 'https://linkedin.com/in/yudhabhakti'],
};

const articleSchema = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.published.toISOString(),
  dateModified: (article.updated ?? article.published).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
  ...(ogImage ? { image: ogImage } : {}),
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    {/* Runs before paint so a pinned theme never flashes. Not deferred, not a module. */}
    <script is:inline>
      {
        const pinned = localStorage.getItem('color-scheme');
        if (pinned === 'light' || pinned === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = pinned;
          document.documentElement.classList.add(`theme-${pinned}`);
        }
      }
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema ?? personSchema)}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-head">
      <div class="wrap site-head__inner">
        <a href="/" class="brand">yudha bhakti</a>

        <nav class="site-nav" aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href || path.startsWith(item.href + '/')
                  ? 'page'
                  : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle colour theme"
            data-theme-toggle
          >
            <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap site-foot__inner">
        <nav aria-label="Elsewhere">
          {SOCIAL.map((s) => <a href={s.href} rel="me noopener">{s.label}</a>)}
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="site-foot__note">Jakarta, Indonesia · UTC+7</p>
      </div>
    </footer>

    <script is:inline>
      {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="color-scheme"]');
        const systemDark = matchMedia('(prefers-color-scheme: dark)');

        const apply = (value) => {
          root.classList.remove('theme-light', 'theme-dark');
          if (value) {
            root.classList.add(`theme-${value}`);
            meta.content = value;
            localStorage.setItem('color-scheme', value);
          } else {
            meta.content = 'light dark';
            localStorage.removeItem('color-scheme');
          }
        };

        document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
          const pinned = localStorage.getItem('color-scheme');
          // Pinned -> back to following the system. Following -> pin the opposite.
          apply(pinned ? null : systemDark.matches ? 'light' : 'dark');
        });
      }
    </script>
  </body>
</html>
