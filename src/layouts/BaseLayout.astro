---
import { SITE, NAV, SOCIAL } from '../consts';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import '../styles/global.css';

// The layout owns structure; Seo owns everything inside <head> that search
// engines read. Pages pass SEO intent straight through.
export type Props = SeoProps;

const path = Astro.url.pathname.replace(/(?<=.)\/$/, '');
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    {/* Runs before paint so a pinned theme never flashes. Not deferred, not a module. */}
    <script is:inline>
      {
        const pinned = localStorage.getItem('color-scheme');
        if (pinned === 'light' || pinned === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = pinned;
          document.documentElement.classList.add(`theme-${pinned}`);
        }
      }
    </script>

    <Seo {...Astro.props} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-head">
      <div class="wrap site-head__inner">
        <a href="/" class="brand">yudha bhakti</a>

        <nav class="site-nav" aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href || path.startsWith(item.href + '/')
                  ? 'page'
                  : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle colour theme"
            data-theme-toggle
          >
            <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap site-foot__inner">
        <nav aria-label="Elsewhere">
          {SOCIAL.map((s) => <a href={s.href} rel="me noopener">{s.label}</a>)}
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="site-foot__note">Jakarta, Indonesia · UTC+7</p>
      </div>
    </footer>

    <script is:inline>
      {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="color-scheme"]');
        const systemDark = matchMedia('(prefers-color-scheme: dark)');

        const apply = (value) => {
          root.classList.remove('theme-light', 'theme-dark');
          if (value) {
            root.classList.add(`theme-${value}`);
            meta.content = value;
            localStorage.setItem('color-scheme', value);
          } else {
            meta.content = 'light dark';
            localStorage.removeItem('color-scheme');
          }
        };

        document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
          const pinned = localStorage.getItem('color-scheme');
          // Pinned -> back to following the system. Following -> pin the opposite.
          apply(pinned ? null : systemDark.matches ? 'light' : 'dark');
        });
      }
    </script>
  </body>
</html>
