---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE } from '../../consts';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

// Declares the listing as a CollectionPage whose ItemList names every post, so
// the index is understood as the parent of the 23 URLs rather than a leaf page.
const listing = posts.map((post) => ({
  name: post.data.title,
  url: `${SITE.url}/writing/${post.id}`,
}));

// Group newest-first by year. Map preserves insertion order, so the groups come
// out in the same order as the sorted posts.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.published.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout
  title="Writing"
  description="Notes on embedded systems, edge computing, cloud architecture, and applied AI — from student rocket competitions to enterprise platforms."
  collection={listing}
  breadcrumbs={[{ name: 'Home', item: SITE.url }, { name: 'Writing' }]}
>
  <section class="hero">
    <h1>Writing</h1>
    <p class="hero__lede">
      Notes on things I have built and things I got wrong &mdash; rockets and robots at
      university, industrial systems since, and lately platforms and applied AI.
    </p>
  </section>

  {
    [...byYear].map(([year, yearPosts]) => (
      <section>
        <h2 class="label">{year}</h2>
        <ul class="entries">
          {yearPosts.map((post) => (
            <li class="entry">
              <a class="entry__link" href={`/writing/${post.id}`}>
                <FormattedDate date={post.data.published} class="entry__date" />
                <span class="entry__title">{post.data.title}</span>
                <span class="entry__desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
