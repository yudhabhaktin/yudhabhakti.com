---
interface Props {
  date: Date;
  class?: string;
  /** Short form shows year only in listings that are already grouped. */
  format?: 'short' | 'long';
}

const { date, class: className, format = 'short' } = Astro.props;

// en-GB gives "1 August 2026" for the long form, but abbreviates September as
// "Sept", which breaks the alignment of the short date column. Short uses en-US
// so every abbreviation is three letters.
const formatted =
  format === 'long'
    ? date.toLocaleDateString('en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        timeZone: 'UTC',
      });
---

<time class={className} datetime={date.toISOString()}>{formatted}</time>
