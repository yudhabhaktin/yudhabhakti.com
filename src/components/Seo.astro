---
/**
 * Every piece of head metadata the site emits, in one place.
 *
 * BaseLayout renders this once, so pages never assemble SEO tags themselves —
 * they pass intent (a title, an article, a collection) and this decides what
 * that means for titles, canonicals, Open Graph, Twitter and JSON-LD.
 */
import { SITE, THEME_COLOR, VERIFICATION } from '../consts';
import { buildSchema, type Breadcrumb } from '../lib/schema';

export interface Props {
  /** Page title, without the site-name suffix. Omitted on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image (1200x630). */
  image?: string;
  /** Topical keywords. Ignored by Google, still read by some other engines. */
  keywords?: readonly string[];
  /** Keeps the page out of search results. Used by /404. */
  noindex?: boolean;
  /** Emit BlogPosting structured data. */
  article?: { published: Date; updated?: Date; tags?: string[] };
  /** Emit CollectionPage + ItemList structured data for a listing page. */
  collection?: { name: string; url: string }[];
  /** Marks this URL as the page representing the person entity. */
  profile?: boolean;
  /** Emit the externally-credited work, attributed to the person entity. */
  works?: boolean;
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  keywords,
  noindex = false,
  article,
  collection,
  profile,
  works,
  breadcrumbs,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;

// One canonical form, no trailing slash, matching the sitemap and the edge
// redirect configured in wrangler.jsonc. Root stays "/".
const base = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, base).href.replace(/(?<=.)\/$/, '');
const ogImage = image ? new URL(image, base).href : undefined;

const schema = buildSchema({
  canonical,
  name: title ?? SITE.title,
  description,
  image: ogImage,
  article,
  collection,
  profile,
  works,
  breadcrumbs,
});

// `max-image-preview:large` is what makes a page eligible for a large thumbnail
// in results and Discover; the snippet limits opt out of truncation.
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={SITE.author} />
<meta name="robots" content={robots} />
{keywords?.length && <meta name="keywords" content={keywords.join(', ')} />}

<meta name="theme-color" media="(prefers-color-scheme: light)" content={THEME_COLOR.light} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={THEME_COLOR.dark} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="en_US" />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={`${SITE.author} — ${SITE.tagline}`} />
    </>
  )
}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
{
  ogImage && (
    <>
      <meta name="twitter:image" content={ogImage} />
      <meta name="twitter:image:alt" content={`${SITE.author} — ${SITE.tagline}`} />
    </>
  )
}

{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.updated && (
        <meta property="article:modified_time" content={article.updated.toISOString()} />
      )}
      <meta property="article:author" content={SITE.author} />
      {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

{VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
{VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
